{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marginalia",
  "version": "2.0.0",
  "identifier": "dev.kaidohex.marginalia",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:spa"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "News",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
